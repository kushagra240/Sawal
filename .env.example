# ==============================================================================
# Sawal - Environment Configuration Template
# Copy to .env locally. NEVER commit .env or real API keys.
# ==============================================================================

# Server/runtime
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOW_GUEST_DEMO=true
STORAGE_BACKEND=memory
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Existing optional service placeholders (not required by the in-memory demo)
SUPABASE_URL=https://<SUPABASE_PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>
CLERK_ISSUER_URL=https://<CLERK_FRONTEND_API_SUBDOMAIN>.clerk.accounts.dev
CLERK_JWKS_URL=https://<CLERK_FRONTEND_API_SUBDOMAIN>.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Hosted open-weight LLM layer
# ------------------------------------------------------------------------------
# Default: hosted Gemma 4 through the native Gemini API.
LLM_PROVIDER=gemini
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Official Gemma 4 IDs currently exposed by the Gemini API include:
#   gemma-4-26b-a4b-it
#   gemma-4-31b-it
# Set the model explicitly for reproducible benchmark evidence.
GEMMA_MODEL_ID=gemma-4-26b-a4b-it
SAWAL_MODEL=gemma-4-26b-a4b-it

# Optional OpenAI-compatible provider. This path is not required for the hosted
# Gemma demo; set it only if you intentionally use a compatible endpoint.
# Google's compatibility base URL is shown as a verified example.
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_KEY=<OPENAI_API_KEY>
LLM_RESPONSE_FORMAT=auto

# Open-weight family allowlist; closed model IDs are rejected.
ALLOWED_MODEL_FAMILIES=gemma,llama,mistral,qwen,deepseek,phi

# live   = call hosted model, no cache write
# record = call hosted model and persist validated proposals to replay cache
# replay = read cache only, never call network
# auto   = live -> replay -> explicit deterministic fallback
LLM_MODE=auto
SAWAL_LLM_MODE=auto
LLM_REPLAY_CACHE_DIR=benchmark/replay_cache

# The public docs state active limits are project/tier-specific and must be
# checked in AI Studio. Keep 10 RPM as a safe default until your project limit
# is verified, then override it here.
LLM_MAX_RPM=10
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=0.5

# Benchmark evidence mode: fail instead of silently using deterministic fallback.
SAWAL_STRICT=0

# Core algorithm
NUM_INTERPRETATIONS=5
DECISION_TAU=0.25
MAX_QUESTIONS=2
WEIGHT_EMAIL_SEND=1.0
WEIGHT_RESTAURANTS_BOOK=0.7
WEIGHT_CALENDAR_CREATE=0.4
WEIGHT_EXPENSES_LOG=0.3
WEIGHT_EMAIL_DRAFT=0.1
BENCHMARK_FLAG_GATED=true

# Existing frontend configuration placeholders (backend does not edit web/)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<CLERK_PUBLISHABLE_KEY>
CLERK_SECRET_KEY=sk_test_<CLERK_SECRET_KEY>
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app
NEXT_PUBLIC_ALLOW_GUEST_DEMO=true
