# ==============================================================================
# Sawal - Environment Configuration Template (.env.example)
# Team: Jugaad Labs | Hacktoberfest Hack Day Pune x Cloud Computing Club 2026
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' in your local root or service subdirectories:
#    Windows PowerShell: Copy-Item .env.example .env
#    macOS/Linux:        cp .env.example .env
# 2. Fill in the required <ANGLE_BRACKET_VALUES> with your real credentials.
# 3. NEVER commit '.env' or any secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME (FastAPI Backend - Teammate A)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=true

# Comma-separated CORS origins allowed to access the backend API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo & Guest Settings
# Set to 'true' to allow unauthenticated test sessions in memory (zero Supabase writes)
ALLOW_GUEST_DEMO=true

# Storage Backend: 'supabase' (production/dev persistence) or 'memory' (tests & offline demo)
STORAGE_BACKEND=memory

# Global request rate limiting for API endpoints (requests per minute per IP / user)
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & STORAGE (Backend Server-Side ONLY - Teammate A)
# ------------------------------------------------------------------------------
# WARNING: The Supabase Service Role Key bypasses RLS and MUST NEVER be exposed
# to the frontend web application or checked into source code.
SUPABASE_URL=https://<SUPABASE_PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>

# ------------------------------------------------------------------------------
# 3. CLERK AUTHENTICATION (Backend Token Verification - Teammate A)
# ------------------------------------------------------------------------------
# Clerk instance issuer URL (e.g., https://verb-noun-00.clerk.accounts.dev)
CLERK_ISSUER_URL=https://<CLERK_FRONTEND_API_SUBDOMAIN>.clerk.accounts.dev

# Clerk JSON Web Key Set URL used by PyJWKClient for RS256 signature verification
CLERK_JWKS_URL=https://<CLERK_FRONTEND_API_SUBDOMAIN>.clerk.accounts.dev/.well-known/jwks.json

# Authorized Parties (azp claim validation in JWT) - comma-separated list
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 4. OPEN-WEIGHT LLM LAYER (Dual Providers - Teammate A)
# ------------------------------------------------------------------------------
# Provider selector: 'gemini' (default, Google Gen AI SDK) or 'openai_compatible' (vLLM, Ollama, Together)
LLM_PROVIDER=gemini

# Google AI Studio / Gemini API Key (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=<GEMINI_API_KEY>

# OpenAI-Compatible Provider Settings (used when LLM_PROVIDER=openai_compatible)
# Examples: Local Ollama (http://localhost:11434/v1), vLLM (http://localhost:8000/v1), or hosted open-weight
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=<OPENAI_API_KEY>

# Enforced open-weight model family allowlist (comma-separated; rejected at startup if model is closed)
ALLOWED_MODEL_FAMILIES=gemma,llama,mistral,qwen

# Model identifier for hosted Gemma 4 via Gemini API (or open-weight equivalent)
# Hosted Gemma 4 model supported by the Gemini API.
GEMMA_MODEL_ID=gemma-4-26b-a4b-it

# LLM execution mode:
# - 'live':   Direct call to model provider for every interpretation/question
# - 'record': Call provider and persist responses to LLM_REPLAY_CACHE_DIR
# - 'replay': Purely offline; replay responses from LLM_REPLAY_CACHE_DIR
# - 'auto':   Attempt live API call; on failure/timeout fallback to replay cache
LLM_MODE=auto

# Local directory where LLM prompt/response recordings are saved
LLM_REPLAY_CACHE_DIR=benchmark/results/replay_cache

# Upstream LLM call timeout in seconds
LLM_TIMEOUT_SECONDS=15

# Max retries with exponential backoff on HTTP 429/503 from model provider
LLM_MAX_RETRIES=3

# Low-latency hosted Gemma settings
GEMMA_THINKING_LEVEL=minimal
LLM_MAX_OUTPUT_TOKENS=2048

# Max concurrent calls to model provider to stay within rate limits
LLM_MAX_CONCURRENCY=4

# Client-side rate limiter: maximum requests per minute (RPM)
# TODO-VERIFY: Verify free-tier requests-per-minute (RPM) limits in Google AI Studio dashboard or Gemini API documentation
LLM_MAX_RPM=15

# ------------------------------------------------------------------------------
# 5. CORE ALGORITHM & POLICY PARAMETERS (Teammate A)
# ------------------------------------------------------------------------------
# Number of distinct interpretations to generate per vague request (K)
NUM_INTERPRETATIONS=5

# Regret threshold (Tau): Ask clarifying question if Expected Regret R > TAU, else act
DECISION_TAU=0.25

# Hard upper limit on clarification questions per session
MAX_QUESTIONS=2

# Reversibility weights for mock world tools (cost penalty in [0.0, 1.0])
WEIGHT_EMAIL_SEND=1.0
WEIGHT_RESTAURANTS_BOOK=0.7
WEIGHT_CALENDAR_CREATE=0.4
WEIGHT_EXPENSES_LOG=0.3
WEIGHT_EMAIL_DRAFT=0.1

# Flag to protect dev-only benchmark execution endpoint (POST /v1/benchmark/runs)
BENCHMARK_FLAG_GATED=true

# ------------------------------------------------------------------------------
# 6. FRONTEND WEB APPLICATION (Next.js App Router - Teammate B)
# ------------------------------------------------------------------------------
# Base URL of the backend FastAPI service
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1

# Clerk Client-Side Public Authentication Key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<CLERK_PUBLISHABLE_KEY>

# Clerk Server-Side Secret Key (Used in Next.js middleware / server components)
CLERK_SECRET_KEY=sk_test_<CLERK_SECRET_KEY>

# Clerk UI Redirect Routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app

# Allow guest demo button on web UI login screen
NEXT_PUBLIC_ALLOW_GUEST_DEMO=true

# ------------------------------------------------------------------------------
# 7. GOOGLE LIVE TOOLS (server-side only)
# ------------------------------------------------------------------------------
# Create a Web application OAuth client in Google Cloud. Never expose these
# values through NEXT_PUBLIC_* variables.
GOOGLE_CLIENT_ID=<GOOGLE_OAUTH_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_OAUTH_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/oauth/google/callback
FRONTEND_URL=http://localhost:3000

# Long random secret used to encrypt OAuth tokens at rest. Keep stable across
# restarts or previously stored connections cannot be decrypted.
SAWAL_TOKEN_ENCRYPTION_KEY=<GENERATE_A_LONG_RANDOM_SECRET>
SAWAL_DATABASE_PATH=.data/sawal.db
PROVIDER_TIMEOUT_SECONDS=20
